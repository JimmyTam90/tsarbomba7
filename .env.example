# All optional. Leave unset to disable the related tracker. Never commit real secrets.
# These are PUBLIC client-side IDs (not secrets).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional. Overrides the default assetPrefix (https://tsarbomba7.vercel.app)

# Defaults to https://tsarbomba7.vercel.app (Spoke domain) when unset
NEXT_PUBLIC_ASSET_PREFIX=
