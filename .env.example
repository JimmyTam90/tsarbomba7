# All optional. Leave unset to disable the related tracker. Never commit real secrets.
# These are PUBLIC client-side IDs (not secrets).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional. Only if static assets 404 behind the hub proxy, e.g. /tsar-bomba-static
NEXT_PUBLIC_ASSET_PREFIX=
